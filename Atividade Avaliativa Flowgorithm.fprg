<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade Avaliativa Flowgorithm"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-10 11:55:07 "/>
        <attribute name="created" value="QWx1bm87RFNOMTIyMTI3Mzg3NzsyMDI2LTA2LTEwOyIwOTo1OTo1MyAiOzI0NjM="/>
        <attribute name="edited" value="QWx1bm87RFNOMTIyMTI3Mzg3NzsyMDI2LTA2LTEwOyIxMTo1NTowNyAiOzE7MjU1OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="destino" type="String" array="False" size=""/>
            <declare name="contador" type="Integer" array="False" size=""/>
            <declare name="pacotes" type="Integer" array="False" size=""/>
            <declare name="custo" type="Real" array="False" size=""/>
            <declare name="peso" type="Real" array="False" size=""/>
            <declare name="cargaTotal" type="Real" array="False" size=""/>
            <assign variable="cargaTotal" expression="0"/>
            <declare name="faturamento" type="Real" array="False" size=""/>
            <assign variable="faturamento" expression="0"/>
            <declare name="ticketMedio" type="Real" array="False" size=""/>
            <output expression="&quot;Qual a quantidade de pacotes?:&quot;" newline="True"/>
            <input variable="pacotes"/>
            <for variable="contador" start="1" end="10" direction="inc" step="1">
                <output expression="&quot;Qual o peso do pacote:&quot;" newline="True"/>
                <input variable="peso"/>
                <if expression="peso &lt;= 2">
                    <then>
                        <assign variable="custo" expression="10"/>
                        <output expression="&quot;Classifica&#231;&#227;o: Leve&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="peso &lt;= 10">
                            <then>
                                <assign variable="custo" expression="20"/>
                                <output expression="&quot;Classifica&#231;&#227;o: Padr&#227;o&quot;" newline="True"/>
                            </then>
                            <else>
                                <assign variable="custo" expression="30"/>
                                <output expression="&quot;Classifica&#231;&#227;o: Pesado&quot;" newline="True"/>
                            </else>
                        </if>
                    </else>
                </if>
                <output expression="&quot;Destino internacional? (1)sim / (2)n&#227;o&quot;" newline="True"/>
                <input variable="destino"/>
                <if expression="destino = &quot;1&quot;">
                    <then>
                        <assign variable="custo" expression="custo * 0.20"/>
                    </then>
                    <else/>
                </if>
                <assign variable="cargaTotal" expression="cargaTotal + peso"/>
                <assign variable="faturamento" expression="faturamento + custo"/>
                <assign variable="ticketMedio" expression="faturamento / 10"/>
            </for>
            <output expression="&quot;========== RESULTADO FINAL ==========&quot;" newline="True"/>
            <output expression="&quot;Total de pacotes: 10&quot;" newline="True"/>
            <output expression="&quot;Carga total acumulada (Kg):&quot;" newline="True"/>
            <output expression="cargaTotal" newline="True"/>
            <output expression="&quot;Faturamento Bruto do Lote: R$&quot;" newline="True"/>
            <output expression="faturamento" newline="True"/>
            <output expression="&quot;Ticket m&#233;dio por pacote: R$&quot;" newline="True"/>
            <output expression="ticketMedio" newline="True"/>
            <output expression="&quot;====================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
